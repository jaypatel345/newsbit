{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --reload"],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 3000
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port $PORT"],
      "port": 3010,
      "autoPort": true
    }
  ]
}
